<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Issue Equipment"
            android:textColor="#17324F"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Record a laboratory equipment loan"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Equipment *"
            android:textColor="#17324F"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spinnerIssueEquipment"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:id="@+id/tvIssueAvailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Select equipment to view available stock."
            android:textColor="#64748B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Student Name *"
            android:textColor="#17324F"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etLoanStudentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., Naren Chittibabu"
            android:inputType="textPersonName|textCapWords"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Register Number *"
            android:textColor="#17324F"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etLoanRegisterNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter student register number"
            android:inputType="textCapCharacters"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Quantity to Issue *"
            android:textColor="#17324F"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etLoanQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 2"
            android:inputType="number"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Return Due Date *"
            android:textColor="#17324F"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnChooseDueDate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#64748B"
            android:text="Choose Due Date"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvSelectedDueDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No due date selected"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnConfirmIssue"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#1E527F"
            android:text="Issue Equipment"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnCancelIssue"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#64748B"
            android:text="Cancel / Back"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>