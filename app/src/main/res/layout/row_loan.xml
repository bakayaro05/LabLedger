<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_stat_card"
    android:orientation="vertical"
    android:padding="15dp">

    <TextView
        android:id="@+id/tvLoanRowEquipment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#17324F"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLoanRowStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLoanRowStudent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#17324F"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvLoanRowDates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvLoanRowQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="#64748B"
        android:textSize="13sp" />

</LinearLayout>