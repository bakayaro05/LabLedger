<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvEquipmentFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Equipment"
            android:textColor="#17324F"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Enter equipment details below"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Equipment Name *"
            android:textColor="#17324F"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etEquipmentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., Arduino Uno"
            android:inputType="textCapWords"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Category *"
            android:textColor="#17324F"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spinnerEquipmentCategory"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Storage Location *"
            android:textColor="#17324F"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etEquipmentLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., Electronics Lab - Shelf A"
            android:inputType="textCapWords"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Total Quantity *"
            android:textColor="#17324F"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etEquipmentQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 5"
            android:inputType="number"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvBorrowedStockHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#B45309"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSaveEquipment"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#1E527F"
            android:text="Save Equipment"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnCancelEquipment"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#64748B"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
