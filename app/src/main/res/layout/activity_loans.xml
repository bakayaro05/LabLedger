<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loans &amp; History"
        android:textColor="#17324F"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Track borrowed equipment and record returns"
        android:textColor="#64748B"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etSearchLoans"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Search student, register no. or equipment"
            android:inputType="text"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnClearLoansSearch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#64748B"
            android:text="Clear"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Loan Status"
        android:textColor="#17324F"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerLoanStatus"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Active includes overdue loans; Returned shows history."
        android:textColor="#64748B"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvLoanCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Showing 0 of 0 loan records"
        android:textColor="#64748B"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvLoansEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="22dp"
        android:text="No loans yet. Use Issue Equipment to create one."
        android:textColor="#64748B"
        android:textSize="15sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listLoans"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp" />

    <Button
        android:id="@+id/btnBackLoans"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#64748B"
        android:text="Back to Dashboard"
        android:textAllCaps="false"
        android:textColor="#FFFFFF" />

</LinearLayout>